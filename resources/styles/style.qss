/* 灵动岛主体样式 */
/* 可修改项：background-color（背景色）、border（边框）、border-radius（圆角） */
#IslandContainer {
    background-color: #000000; /* 黑色背景 */
    border: 1px solid #1A1A1A; /* 深灰色边框 */
    border-radius: 20px; /* 20px圆角，营造胶囊形状 */
}

/* 时间文字样式 */
/* 可修改项：color（文字颜色）、font-size（字体大小）、font-weight（字重） */
#TimeLabel {
    color: #FFFFFF; /* 纯白色文字 */
    font-family: "微软雅黑", "Microsoft YaHei", sans-serif; /* 字体，优先使用微软雅黑 */
    font-size: 15px; /* 15px字体大小 */
    font-weight: bold; /* 粗体 */
}

/* 图标样式 */
/* 可修改项：color（图标颜色）、font-size（图标大小） */
#IconLabel {
    color: #FFFFFF; /* 纯白色图标 */
    font-size: 18px; /* 18px图标大小 */
    font-family: "微软雅黑", "Microsoft YaHei", sans-serif; /* 字体，优先使用微软雅黑 */
}

/* 数值百分比样式 */
/* 可修改项：color（文字颜色）、font-size（字体大小） */
#ValueLabel {
    color: #FFFFFF; /* 纯白色文字 */
    font-size: 12px; /* 12px字体大小 */
    font-family: "微软雅黑", "Microsoft YaHei", monospace; /* 字体，优先使用微软雅黑 */
    font-weight: bold; /* 粗体 */
}

/* 现代滑动条定制 */
/* 滑动条轨道样式 */
/* 可修改项：height（轨道高度）、background（轨道背景色）、border-radius（轨道圆角） */
QSlider#CapsuleSlider::groove:horizontal {
    height: 6px; /* 轨道高度，可调整粗细 */
    background: #2A2A2D; /* 轨道背景色 */
    border-radius: 3px; /* 轨道圆角，建议为高度的一半 */
    margin: 6px 0; /* 上下边距，调整滑动条在垂直方向的位置 */
}

/* 滑动条已填充部分样式 */
/* 可修改项：background（填充颜色或渐变）、border-radius（填充部分圆角） */
QSlider#CapsuleSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #007AFF, stop:1 #0056B3); /* 蓝色渐变填充 */
    border-radius: 3px; /* 填充部分圆角，建议与轨道一致 */
}

/* 滑动条滑块样式（当前隐藏） */
/* 可修改项：width/height（滑块大小）、background（滑块背景）、border-radius（滑块圆角） */
QSlider#CapsuleSlider::handle:horizontal {
    width: 0px; /* 滑块宽度，0表示隐藏 */
    height: 0px; /* 滑块高度，0表示隐藏 */
    background: transparent; /* 滑块背景，transparent表示透明 */
    border: none; /* 滑块边框，none表示无 */
    margin: 0; /* 滑块边距 */
}

/* 滑动条滑块悬停样式（当前隐藏） */
/* 与滑块样式保持一致，确保悬停时也隐藏 */
QSlider#CapsuleSlider::handle:horizontal:hover {
    width: 0px;
    height: 0px;
    background: transparent;
    border: none;
    margin: 0;
}

/* 鼠标悬停时轨道的效果 */
/* 可修改项：background（悬停时的轨道背景色） */
QSlider#CapsuleSlider::groove:horizontal:hover {
    background: #353538; /* 悬停时的轨道背景色，比默认稍亮 */
}

/* 状态栏标签样式 */
/* 可修改项：color（文字颜色）、font-size（字体大小） */
#StatusLabel {
    color: #FFFFFF; /* 纯白色文字 */
    font-size: 12px; /* 12px字体大小 */
    font-family: "微软雅黑", "Microsoft YaHei", sans-serif; /* 字体，优先使用微软雅黑 */
    font-weight: bold; /* 粗体 */
}

#UrlDialog {
    background-color: #1C1C1E;
    border: 1px solid #3A3A3C;
    border-radius: 12px;
}

#DialogTitle {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: bold;
    font-family: "微软雅黑", "Microsoft YaHei", sans-serif;
}

#UrlLabel {
    color: #8E8E93;
    font-size: 12px;
    font-family: "微软雅黑", "Microsoft YaHei", sans-serif;
    padding: 5px;
}

QCheckBox {
    color: #FFFFFF;
    font-size: 12px;
    font-family: "微软雅黑", "Microsoft YaHei", sans-serif;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 2px solid #3A3A3C;
    background-color: transparent;
}

QCheckBox::indicator:checked {
    background-color: #007AFF;
    border: 2px solid #007AFF;
}

QCheckBox::indicator:hover {
    border: 2px solid #007AFF;
}

#DialogButton {
    background-color: #3A3A3C;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-family: "微软雅黑", "Microsoft YaHei", sans-serif;
    font-weight: bold;
    min-width: 70px;
    min-height: 18px;
}

#DialogButton:hover {
    background-color: #48484A;
}

#DialogButton:pressed {
    background-color: #2C2C2E;
}