/* 灵动岛主体样式 */
/* 可修改项：background-color（背景色）、border（边框）、border-radius（圆角） */
#IslandContainer {
    background-color: #000000; /* 黑色背景 */
    border: 1px solid #1A1A1A; /* 深灰色边框 */
    border-radius: 20px; /* 20px圆角，营造胶囊形状 */
}

/* 时间文字样式 */
/* 可修改项：color（文字颜色）、font-size（字体大小）、font-weight（字重） */
#TimeLabel {
    color: #FFFFFF; /* 纯白色文字 */
    font-family: "微软雅黑", "Microsoft YaHei", sans-serif; /* 字体，优先使用微软雅黑 */
    font-size: 15px; /* 15px字体大小 */
    font-weight: bold; /* 粗体 */
}

/* 日期+时间文字样式 */
#DateLabel {
    color: #FFFFFF; /* 纯白色文字 */
    font-family: "微软雅黑", "Microsoft YaHei", sans-serif;
    font-size: 14px;
    font-weight: bold;
}

/* 图标样式 */
/* 可修改项：color（图标颜色）、font-size（图标大小） */
#IconLabel {
    color: #FFFFFF; /* 纯白色图标 */
    font-size: 18px; /* 18px图标大小 */
    font-family: "微软雅黑", "Microsoft YaHei", sans-serif; /* 字体，优先使用微软雅黑 */
}

/* 数值百分比样式 */
/* 可修改项：color（文字颜色）、font-size（字体大小） */
#ValueLabel {
    color: #FFFFFF; /* 纯白色文字 */
    font-size: 12px; /* 12px字体大小 */
    font-family: "微软雅黑", "Microsoft YaHei", monospace; /* 字体，优先使用微软雅黑 */
    font-weight: bold; /* 粗体 */
}

/* 现代滑动条定制 */
/* 滑动条轨道样式 */
/* 可修改项：height（轨道高度）、background（轨道背景色）、border-radius（轨道圆角） */
QSlider#CapsuleSlider::groove:horizontal {
    border: none;
    height: 8px;
    background: #2A2A2D;
    border-radius: 4px;
}

/* 滑动条已填充部分样式 */
/* 可修改项：background（填充颜色或渐变）、border-radius（填充部分圆角） */
QSlider#CapsuleSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #007AFF, stop:1 #0056B3);
    border-radius: 4px;
    border: none;
}

/* 滑动条滑块样式（胶囊形状） */
QSlider#CapsuleSlider::handle:horizontal {
    width: 20px;
    height: 20px;
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
                stop:0 #FFFFFF, stop:1 #E0E0E0);
    border-radius: 10px;
    margin: -6px 0;
}

/* 滑动条滑块悬停样式 */
QSlider#CapsuleSlider::handle:horizontal:hover {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
                stop:0 #FFFFFF, stop:1 #FFFFFF);
}

/* 鼠标悬停时轨道的效果 */
QSlider#CapsuleSlider::groove:horizontal:hover {
    background: #353538;
}

/* 状态栏标签样式 */
/* 可修改项：color（文字颜色）、font-size（字体大小） */
#StatusLabel {
    color: #FFFFFF; /* 纯白色文字 */
    font-size: 12px; /* 12px字体大小 */
    font-family: "微软雅黑", "Microsoft YaHei", sans-serif; /* 字体，优先使用微软雅黑 */
    font-weight: bold; /* 粗体 */
}

/* URL对话框样式 */
/* 可修改项：background-color（背景色）、border（边框）、border-radius（圆角） */
#UrlDialog {
    background-color: #1C1C1E; /* 深色背景 */
    border: 1px solid #3A3A3C; /* 边框颜色 */
    border-radius: 12px; /* 圆角大小 */
}

/* 对话框标题样式 */
/* 可修改项：color（文字颜色）、font-size（字体大小）、font-weight（字重） */
#DialogTitle {
    color: #FFFFFF; /* 白色文字 */
    font-size: 16px; /* 字体大小 */
    font-weight: bold; /* 粗体 */
    font-family: "微软雅黑", "Microsoft YaHei", sans-serif; /* 字体 */
}

/* URL标签样式 */
/* 可修改项：color（文字颜色）、font-size（字体大小）、padding（内边距） */
#UrlLabel {
    color: #8E8E93; /* 灰色文字 */
    font-size: 12px; /* 字体大小 */
    font-family: "微软雅黑", "Microsoft YaHei", sans-serif; /* 字体 */
    padding: 5px; /* 内边距 */
    min-height: 20px; /* 最小高度 */
}

/* 复选框样式 */
/* 可修改项：color（文字颜色）、font-size（字体大小）、spacing（间距） */
QCheckBox {
    color: #FFFFFF; /* 白色文字 */
    font-size: 12px; /* 字体大小 */
    font-family: "微软雅黑", "Microsoft YaHei", sans-serif; /* 字体 */
    spacing: 8px; /* 文字与复选框的间距 */
}

/* 复选框指示器样式 */
/* 可修改项：width（宽度）、height（高度）、border-radius（圆角）、border（边框） */
QCheckBox::indicator {
    width: 18px; /* 宽度 */
    height: 18px; /* 高度 */
    border-radius: 4px; /* 圆角 */
    border: 2px solid #3A3A3C; /* 边框颜色 */
    background-color: transparent; /* 透明背景 */
}

/* 复选框选中状态样式 */
/* 可修改项：background-color（背景色）、border（边框） */
QCheckBox::indicator:checked {
    background-color: #007AFF; /* 选中时背景色 */
    border: 2px solid #007AFF; /* 选中时边框颜色 */
}

/* 复选框悬停状态样式 */
/* 可修改项：border（边框） */
QCheckBox::indicator:hover {
    border: 2px solid #007AFF; /* 悬停时边框颜色 */
}

/* 对话框按钮样式 */
/* 可修改项：background-color（背景色）、color（文字颜色）、border-radius（圆角）、padding（内边距）、font-size（字体大小） */
#DialogButton {
    background-color: #3A3A3C; /* 按钮背景色 */
    color: #FFFFFF; /* 按钮文字颜色 */
    border: none; /* 无边框 */
    border-radius: 8px; /* 圆角 */
    padding: 8px 16px; /* 内边距 */
    font-size: 13px; /* 字体大小 */
    font-family: "微软雅黑", "Microsoft YaHei", sans-serif; /* 字体 */
    font-weight: bold; /* 粗体 */
    min-width: 70px; /* 最小宽度 */
    min-height: 18px; /* 最小高度 */
}

/* 对话框按钮悬停样式 */
/* 可修改项：background-color（背景色） */
#DialogButton:hover {
    background-color: #48484A; /* 悬停时背景色 */
}

/* 对话框按钮按下样式 */
/* 可修改项：background-color（背景色） */
#DialogButton:pressed {
    background-color: #2C2C2E; /* 按下时背景色 */
}

/* 悬停态信息标签容器样式 */
#HoverInfoLabel {
    background-color: transparent;
}

/* 悬停态时间标签样式 */
#HoverTimeLabel {
    color: #FFFFFF;
    font-family: "微软雅黑", "Microsoft YaHei", sans-serif;
    font-size: 13px;
    font-weight: bold;
}

/* 悬停态CPU标签样式 */
#HoverCpuLabel {
    color: #8E8E93;
    font-family: "微软雅黑", "Microsoft YaHei", sans-serif;
    font-size: 11px;
    font-weight: bold;
}

/* 悬停态内存标签样式 */
#HoverMemoryLabel {
    color: #8E8E93;
    font-family: "微软雅黑", "Microsoft YaHei", sans-serif;
    font-size: 11px;
    font-weight: bold;
}

/* 连接信息标签样式 */
#ConnectionLabel {
    color: #FFFFFF;
    font-family: "微软雅黑", "Microsoft YaHei", sans-serif;
    font-size: 12px;
    font-weight: bold;
}