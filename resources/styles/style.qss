/* 灵动岛主体样式 */
/* 可修改项：background-color（背景色）、border（边框）、border-radius（圆角） */
#IslandContainer {
    background-color: #000000; /* 黑色背景 */
    border: 1px solid #1A1A1A; /* 深灰色边框 */
    border-radius: 20px; /* 20px圆角，营造胶囊形状 */
}

/* 时间文字样式 */
/* 可修改项：color（文字颜色）、font-size（字体大小）、font-weight（字重） */
#TimeLabel {
    color: #FFFFFF; /* 纯白色文字 */
    font-family: "微软雅黑", "Microsoft YaHei", sans-serif; /* 字体，优先使用微软雅黑 */
    font-size: 15px; /* 15px字体大小 */
    font-weight: bold; /* 粗体 */
}

/* 日期+时间文字样式 */
#DateLabel {
    color: #FFFFFF; /* 纯白色文字 */
    font-family: "微软雅黑", "Microsoft YaHei", sans-serif;
    font-size: 14px;
    font-weight: bold;
}

/* 图标样式 */
/* 可修改项：color（图标颜色）、font-size（图标大小） */
#IconLabel {
    color: #FFFFFF; /* 纯白色图标 */
    font-size: 18px; /* 18px图标大小 */
    font-family: "微软雅黑", "Microsoft YaHei", sans-serif; /* 字体，优先使用微软雅黑 */
}

/* 数值百分比样式 */
/* 可修改项：color（文字颜色）、font-size（字体大小） */
#ValueLabel {
    color: #FFFFFF; /* 纯白色文字 */
    font-size: 12px; /* 12px字体大小 */
    font-family: "微软雅黑", "Microsoft YaHei", monospace; /* 字体，优先使用微软雅黑 */
    font-weight: bold; /* 粗体 */
}

/* 现代滑动条定制 */
/* 滑动条轨道样式 */
/* 可修改项：height（轨道高度）、background（轨道背景色）、border-radius（轨道圆角） */
QSlider#CapsuleSlider::groove:horizontal {
    border: none;
    height: 8px;
    background: #2A2A2D;
    border-radius: 4px;
}

/* 滑动条已填充部分样式 */
/* 可修改项：background（填充颜色或渐变）、border-radius（填充部分圆角） */
QSlider#CapsuleSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #007AFF, stop:1 #0056B3);
    border-radius: 4px;
    border: none;
}

/* 滑动条滑块样式（胶囊形状） */
QSlider#CapsuleSlider::handle:horizontal {
    width: 20px;
    height: 20px;
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
                stop:0 #FFFFFF, stop:1 #E0E0E0);
    border-radius: 10px;
    margin: -6px 0;
}

/* 滑动条滑块悬停样式 */
QSlider#CapsuleSlider::handle:horizontal:hover {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
                stop:0 #FFFFFF, stop:1 #FFFFFF);
}

/* 鼠标悬停时轨道的效果 */
QSlider#CapsuleSlider::groove:horizontal:hover {
    background: #353538;
}

/* 状态栏标签样式 */
/* 可修改项：color（文字颜色）、font-size（字体大小） */
#StatusLabel {
    color: #FFFFFF; /* 纯白色文字 */
    font-size: 12px; /* 12px字体大小 */
    font-family: "微软雅黑", "Microsoft YaHei", sans-serif; /* 字体，优先使用微软雅黑 */
    font-weight: bold; /* 粗体 */
}

#UrlDialog {
    background-color: #1C1C1E;
    border: 1px solid #3A3A3C;
    border-radius: 12px;
}

#DialogTitle {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: bold;
    font-family: "微软雅黑", "Microsoft YaHei", sans-serif;
}

#UrlLabel {
    color: #8E8E93;
    font-size: 12px;
    font-family: "微软雅黑", "Microsoft YaHei", sans-serif;
    padding: 5px;
    min-height: 20px;
}

QCheckBox {
    color: #FFFFFF;
    font-size: 12px;
    font-family: "微软雅黑", "Microsoft YaHei", sans-serif;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 2px solid #3A3A3C;
    background-color: transparent;
}

QCheckBox::indicator:checked {
    background-color: #007AFF;
    border: 2px solid #007AFF;
}

QCheckBox::indicator:hover {
    border: 2px solid #007AFF;
}

#DialogButton {
    background-color: #3A3A3C;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-family: "微软雅黑", "Microsoft YaHei", sans-serif;
    font-weight: bold;
    min-width: 70px;
    min-height: 18px;
}

#DialogButton:hover {
    background-color: #48484A;
}

#DialogButton:pressed {
    background-color: #2C2C2E;
}